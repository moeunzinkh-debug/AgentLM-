<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy for talking to inference servers.

  * TLS is required everywhere, but user-installed CAs are trusted so a self-signed
    LM Studio / llama.cpp server on the LAN works after the cert is installed.
  * Cleartext HTTP is allowed only for loopback-ish targets (emulator -> host, on-device
    llama.cpp / Ollama sidecars). Everything else would be blocked by Android 9+.
  * `src/debug/res/xml/network_security_config.xml` relaxes this so a LAN address such as
    http://192.168.1.20:11434 works while developing.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" trust-user-certificates="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
